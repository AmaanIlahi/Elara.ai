# Copy to .env for local dev. On Fly, set these with `fly secrets set` (secrets)
# or the [env] block in fly.toml (non-secrets). Never commit real values.

# --- App ---
APP_NAME=Elara AI Backend
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000        # declared in config.py but currently unused (CORS is hard-coded)
PUBLIC_BACKEND_BASE_URL=http://localhost:8000  # prod: https://backend-purple-pine-3154.fly.dev (VAPI webhook target)
PUBLIC_FRONTEND_BASE_URL=http://localhost:3000 # currently unused

# --- LLM (Gemini) ---
LLM_ENABLED=false                            # must be true for Gemini to be used
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key           # SECRET
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_SECONDS=15

# --- Voice (VAPI) ---
VAPI_API_KEY=your-vapi-api-key               # SECRET
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_WEBHOOK_SECRET=a-long-random-string      # SECRET; VAPI echoes it in the X-Vapi-Secret header. Generate: openssl rand -hex 32
VAPI_ASSISTANT_NAME=Elara Voice Scheduler

# --- Fly (set in fly.toml [env]) ---
PORT=8000
